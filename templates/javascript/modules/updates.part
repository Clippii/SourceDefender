function planUpdate(current, target, digest, signers) {
  if (current === target) return { required: false, version: current };
  if (!/^[a-f0-9]{64}$/.test(digest)) throw new Error('Expected SHA-256 digest');
  const feed = resolve_updates();
  if (new URL(feed).protocol !== 'https:') throw new Error('Update feed must use HTTPS');
  return { required: true, from: current, to: target, feed, digest,
    signers: [...signers], requiresSignature: true, dryRun: true };
}

function compareVersions(left, right) {
  function parts(value) {
    if (!/^\d+\.\d+\.\d+$/.test(value)) throw new Error('Expected major.minor.patch');
    return value.split('.').map(Number);
  }
  const a = parts(left), b = parts(right);
  for (let i = 0; i < 3; i++) { if (a[i] !== b[i]) return Math.sign(a[i] - b[i]); }
  return 0;
}

Object.assign(module.exports, { planUpdate, compareVersions });
